{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    {
      "source": "/((?!api/|.*\\.(?:mp4|mov|webm|png|jpe?g|webp|svg|gif|ico|woff2?|ttf|css|js|map|json|txt|xml|mp3|wav)$).*)",
      "destination": "/index.html"
    }
  ]
}
