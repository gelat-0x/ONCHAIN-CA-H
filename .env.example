# Server
PORT=3001
NODE_ENV=development

# Dune Analytics (required for PegKeeper data)
DUNE_API_KEY=your_dune_api_key_here
DUNE_PEGKEEPER_QUERY_ID=7767958

# CoinGecko (optional, increases rate limit)
COINGECKO_API_KEY=

# Show topic submissions → inbox (never exposed to the browser)
# Defaults to FraxForce@gmail.com when unset — override here if needed.
SHOW_TOPIC_EMAIL=FraxForce@gmail.com
# Public site origin for FormSubmit (defaults to request Origin / onchaincash.app)
SHOW_TOPIC_SITE_URL=https://onchaincash.app
# Optional Discord/Slack webhook (must be a webhook URL, not a discord.gg invite):
SHOW_TOPIC_WEBHOOK_URL=

# Vercel CLI / deploy (never commit real token)
VERCEL_TOKEN=
