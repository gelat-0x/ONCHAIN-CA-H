{
  "name": "onchain-ca-h",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort --force",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm:server\" \"npm:dev\"",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && node scripts/bundle-api.mjs",
    "build:api": "node scripts/bundle-api.mjs",
    "start": "NODE_ENV=production node --import tsx/esm server/index.ts",
    "typecheck": "tsc -b",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.node.json --outDir dist-server server/index.ts || echo 'Server build optional'",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:logos": "node scripts/sync-token-logos.mjs && node scripts/generate-logo-placeholders.mjs",
    "fetch:studio-bg": "node scripts/fetch-studio-backgrounds.mjs || node scripts/generate-studio-backgrounds.mjs",
    "generate:studio-bg": "node scripts/generate-studio-backgrounds.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "countup.js": "^2.10.0",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vercel": "^58.5.1",
    "vite": "^8.0.12"
  }
}
